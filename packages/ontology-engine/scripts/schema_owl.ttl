@prefix cmns-loc: <https://www.omg.org/spec/Commons/Locations/> .
@prefix cmns-q: <https://www.omg.org/spec/Commons/Quantities/> .
@prefix cmns-txt: <https://www.omg.org/spec/Commons/Text/> .
