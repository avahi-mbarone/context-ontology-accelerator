{
  "name": "infra",
  "namedInputs": { "default": ["typescript"] },
  "implicitDependencies": ["coa-web-app"],
  "targets": {
    "synth": {
      "command": "pnpm --filter coa-infra exec cdk synth",
      "dependsOn": ["build"]
    },
    "deploy": {
      "command": "pnpm --filter coa-infra exec cdk deploy --all --require-approval=never",
      "dependsOn": ["synth"]
    }
  }
}
