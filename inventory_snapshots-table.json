{
  "Name": "inventory_snapshots",
  "TableType": "EXTERNAL_TABLE",
  "Parameters": {
    "classification": "csv",
    "skip.header.line.count": "1"
  },
  "StorageDescriptor": {
    "Columns": [
      {"Name": "product_id", "Type": "string", "Comment": "FK to products.product_id"},
      {"Name": "warehouse_id", "Type": "string", "Comment": "Warehouse identifier, e.g. WH-EAST"},
      {"Name": "snapshot_date", "Type": "string", "Comment": "Snapshot date, YYYY-MM-DD"},
      {"Name": "quantity_on_hand", "Type": "int", "Comment": "Units in stock at snapshot time"}
    ],
    "Location": "s3://coa-dev-sources-data-<ACCOUNT_ID>/synthetic-test/inventory_snapshots/",
    "InputFormat": "org.apache.hadoop.mapred.TextInputFormat",
    "OutputFormat": "org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat",
    "SerdeInfo": {
      "SerializationLibrary": "org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe",
      "Parameters": {
        "field.delim": ","
      }
    }
  }
}
